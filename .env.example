# ==========================================
# ANUBIS MUSIC BOT - CONFIGURACAO
# ==========================================
# Copie este arquivo como .env e preencha
# ==========================================

# TOKEN do bot (OBRIGATORIO)
TOKEN=''

# Prefixo padrao dos comandos de texto
DEFAULT_PREFIX='!!'

# URL do MongoDB (opcional)
MONGO=''

# Spotify API (opcional - use os defaults ou insira os seus)
SPOTIFY_CLIENT_ID='6f9cb59f727b41c4b471db9140fb9c29'
SPOTIFY_CLIENT_SECRET='13e16bc355b24125b9799e7045b0303c'

# Last.fm API (opcional)
LASTFM_KEY=''
LASTFM_SECRET=''

# ID do dono do bot
OWNER_IDS=''

# Servidor de suporte
SUPPORT_SERVER=''

# Webhooks para logs (opcional)
BOT_ADD_REMOVE_LOG=''
ERROR_REPORT_WEBHOOK=''
AUTO_ERROR_REPORT_WEBHOOK=''

# Logs / Web / Lavalink
ENABLE_LOGGER=true
RUN_RPC_SERVER=true
PORT=8080
AUTO_DOWNLOAD_LAVALINK_SERVERLIST=false
RUN_LOCAL_LAVALINK=true
CONNECT_LOCAL_LAVALINK=true
LAVALINK_FILE_URL=https://github.com/lavalink-devs/lavalink/releases/download/4.2.2/Lavalink.jar
ENABLE_COMMANDS_COOLDOWN=true

# YouTube / Áudio
USE_YTDL=true

# Proxy para YouTube (yt-dlp + Lavalink), ex: http://user:pass@ip:port
# Deixa vazio para conexao direta
YT_PROXY=

# Dashboard (URL interna da API do bot)
# Em Docker: http://anubis-bot:8080
# Local: http://localhost:8080
BOT_API_URL=http://localhost:8080

# Intents
MESSAGE_CONTENT_INTENT=true
GUILD_MESSAGES_INTENT=true
VOICE_STATES_INTENT=true
GUILDS_INTENT=true
MEMBERS_INTENT=true
PRESENCES_INTENT=true
